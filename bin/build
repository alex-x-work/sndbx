#!/usr/bin/env bash
# Build an image from images/<name>/, always without the docker cache.
# Images are tagged <prefix>:<name>, with the prefix from `sndbx --tag-prefix`.
# An image built FROM ${TAG_PREFIX}:base gets the base image built first, but only if it doesn't exist yet.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGES_DIR="$(cd "$BIN_DIR/../images" && pwd)"
BASE_NAME=base
TAG_PREFIX=

fail() {
  echo "Error: $*" >&2
  exit 1
}

# Every directory in images/ with a Dockerfile, base included.
image_names() {
  local dir
  for dir in "$IMAGES_DIR"/*/; do
    dir="$(basename "$dir")"
    if [[ -f "$IMAGES_DIR/$dir/Dockerfile" ]]; then echo "$dir"; fi
  done
}

usage() {
  local script
  script="$(basename "$0")"

  echo "Usage: $script IMAGE    build an image"
  echo "       $script --all    build all images"
  echo
  echo "Images: $(image_names | paste -sd ' ' -)"
}

tag_for() {
  echo "$TAG_PREFIX:$1"
}

needs_base() {
  grep -qE '^FROM[[:space:]]+\$\{TAG_PREFIX\}:'"$BASE_NAME"'([[:space:]]|$)' "$IMAGES_DIR/$1/Dockerfile"
}

base_exists() {
  docker image inspect "$(tag_for "$BASE_NAME")" > /dev/null 2>&1
}

build() {
  local tag args=()
  tag="$(tag_for "$1")"

  # Only images FROM ${TAG_PREFIX}:base declare the arg, docker warns about unused ones.
  if needs_base "$1"; then args=(--build-arg "TAG_PREFIX=$TAG_PREFIX"); fi

  echo "==> Building $tag from images/$1"
  docker build --no-cache "${args[@]}" -t "$tag" "$IMAGES_DIR/$1" || fail "failed to build $tag."
}

build_with_base() {
  if [[ "$1" != "$BASE_NAME" ]] && needs_base "$1" && ! base_exists; then
    echo "==> $(tag_for "$BASE_NAME") doesn't exist yet"
    build "$BASE_NAME"
  fi

  build "$1"
}

build_all() {
  local image

  # Base goes first, so every other image is built on the fresh one.
  for image in $BASE_NAME $(image_names | grep -vxF "$BASE_NAME"); do
    build_with_base "$image"
  done
}

main() {
  [[ $# -eq 1 ]] || { usage >&2; exit 1; }

  local names
  names="$(image_names)"

  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --all) ;;
    *)
      [[ $'\n'"$names"$'\n' == *$'\n'"$1"$'\n'* ]] ||
        fail "unknown image '$1', expected one of: $(echo "$names" | paste -sd ' ' -)."
      ;;
  esac

  TAG_PREFIX="$("$BIN_DIR/sndbx" --tag-prefix)" || fail "cannot read the tag prefix from sndbx."

  command -v docker > /dev/null || fail "docker is not installed."
  docker info > /dev/null 2>&1 || fail "cannot reach the docker daemon, is it running?"

  if [[ "$1" == "--all" ]]; then build_all; else build_with_base "$1"; fi
}

main "$@"
