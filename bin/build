#!/usr/bin/env ruby
# Build an image from images/<name>/, always without the docker cache.
# Images are tagged <prefix>:<name>, with the prefix from `sndbx --tag-prefix`.
# An image built FROM ${TAG_PREFIX}:base gets the base image built first, but only if it doesn't exist yet.

class Builder
  DOCKER = 'docker'.freeze
  BIN_DIR = __dir__.freeze
  IMAGES_DIR = File.expand_path('../images', BIN_DIR).freeze
  BASE_NAME = 'base'.freeze
  BASE_FROM_FORMAT = /^FROM\s+\$\{TAG_PREFIX\}:#{BASE_NAME}(?:\s|$)/.freeze

  # Every directory in images/ with a Dockerfile, base included.
  def self.image_names
    Dir.glob('*/Dockerfile', base: IMAGES_DIR).map { |path| File.dirname(path) }.sort
  end

  def initialize(tag_prefix)
    @tag_prefix = tag_prefix
  end

  def build_all
    # Base goes first, so every other image is built on the fresh one.
    [BASE_NAME, *(self.class.image_names - [BASE_NAME])].each { |name| build_with_base(name) }
  end

  def build_with_base(name)
    if name != BASE_NAME && needs_base?(name) && !base_exists?
      puts "==> #{tag_for(BASE_NAME)} doesn't exist yet"
      build(BASE_NAME)
    end

    build(name)
  end

  private

  def build(name)
    tag = tag_for(name)

    # Only images FROM ${TAG_PREFIX}:base declare the arg, docker warns about unused ones.
    args = needs_base?(name) ? ['--build-arg', "TAG_PREFIX=#{@tag_prefix}"] : []

    puts "==> Building #{tag} from images/#{name}"
    abort("Error: failed to build #{tag}.") unless system(DOCKER, 'build', '--no-cache', *args, '-t', tag, image_dir(name))
  end

  def needs_base?(name)
    File.read(File.join(image_dir(name), 'Dockerfile')).match?(BASE_FROM_FORMAT)
  end

  def base_exists?
    quiet_system(DOCKER, 'image', 'inspect', tag_for(BASE_NAME))
  end

  def tag_for(name)
    "#{@tag_prefix}:#{name}"
  end

  def image_dir(name)
    File.join(IMAGES_DIR, name)
  end

  def quiet_system(*command)
    system(*command, out: File::NULL, err: File::NULL)
  end
end

def usage
  script = File.basename($PROGRAM_NAME)

  <<~USAGE
    Usage: #{script} IMAGE    build an image
           #{script} --all    build all images

    Images: #{Builder.image_names.join(' ')}
  USAGE
end

def tag_prefix
  prefix = IO.popen([File.join(Builder::BIN_DIR, 'sndbx'), '--tag-prefix'], &:read).chomp
  abort('Error: cannot read the tag prefix from sndbx.') unless $?.success? && !prefix.empty?

  prefix
end

def check_docker
  abort('Error: docker is not installed.') unless system(Builder::DOCKER, '--version', out: File::NULL, err: File::NULL)
  abort('Error: cannot reach the docker daemon, is it running?') unless system(Builder::DOCKER, 'info', out: File::NULL, err: File::NULL)
end

abort(usage) unless ARGV.length == 1

target = ARGV.first
names = Builder.image_names

case target
when '-h', '--help'
  puts usage
  exit(0)
when '--all'
  nil
else
  abort("Error: unknown image '#{target}', expected one of: #{names.join(' ')}.") unless names.include?(target)
end

builder = Builder.new(tag_prefix)
check_docker

target == '--all' ? builder.build_all : builder.build_with_base(target)
