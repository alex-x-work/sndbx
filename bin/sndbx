#!/usr/bin/env ruby

require 'fileutils'
require 'optparse'
require 'yaml'

VERSION = '0.11.0'.freeze

class SndbxCliParser
  COMMANDS = %w[run build].freeze

  def call
    parser = OptionParser.new do |opts|
      opts.banner = 'Usage: sndbx command [options]'
      opts.separator ''
      opts.separator 'Commands:'
      opts.separator '    run IMAGE      Run a sandboxed image'
      opts.separator '    build IMAGE    Build an image'
      opts.separator ''
      opts.separator "Run 'sndbx command --help' for a command's options."
      opts.separator ''

      opts.on('-V', '--version', 'Print version') do
        puts "sndbx #{VERSION}"
        exit(0)
      end

      opts.on('-h', '--help', 'Print help') do
        puts opts
        exit(0)
      end
    end

    # Stop at the command, its options are parsed by the command's parser.
    parser.order!
    command = ARGV.shift

    abort(parser.help) unless command
    abort("Error: unknown command '#{command}', expected one of: #{COMMANDS.join(', ')}.") unless COMMANDS.include?(command)

    command
  rescue OptionParser::ParseError => e
    abort("Error: #{e.message}.")
  end
end

class RunCliParser
  def call
    volumes = []
    ports = []
    workdir = nil

    OptionParser.new do |opts|
      opts.banner = 'Usage: sndbx run IMAGE [options]'
      opts.separator ''
      opts.separator "Runs a sandboxed image from #{Settings::PATH}."
      opts.separator 'Mounts the current directory unless volumes are given.'
      opts.separator ''

      opts.on('-v', '--volume=DIR', "Mount a directory as #{Sandbox::MOUNT_ROOT}/<basename>, repeatable") do |dir|
        volumes.push(dir)
      end

      opts.on('-w', '--workdir=NAME', "Start in #{Sandbox::MOUNT_ROOT}/<NAME>, the last volume by default") do |name|
        workdir = name
      end

      opts.on('-p', '--publish=PORT', 'Publish a port as HOST:CONTAINER, PORT means PORT:PORT, repeatable') do |port|
        ports.push(port)
      end

      opts.on('-l', '--list', 'Print image names') do
        puts Settings.new.image_names if File.exist?(Settings::PATH)
        exit(0)
      end

      opts.on('-h', '--help', 'Print help') do
        puts opts
        exit(0)
      end
    end.parse!

    abort('Error: expected exactly one image.') unless ARGV.length == 1

    { image: ARGV.first, volumes: volumes, ports: ports, workdir: workdir }
  rescue OptionParser::ParseError => e
    abort("Error: #{e.message}.")
  end
end

class BuildCliParser
  def call
    all = false

    OptionParser.new do |opts|
      opts.banner = 'Usage: sndbx build IMAGE | --all'
      opts.separator ''
      opts.separator "Builds an image from #{Builder::IMAGES_DIR_SETTING}/IMAGE, always without the docker cache."
      opts.separator "Builds #{Builder::BASE_NAME} first if the image needs it and it doesn't exist yet."
      opts.separator ''

      opts.on('-a', '--all', "Build #{Builder::BASE_NAME}, then every other image") do
        all = true
      end

      opts.on('-l', '--list', 'Print image names') do
        puts Builder.new(Settings.new).image_names
        exit(0)
      end

      opts.on('-h', '--help', 'Print help') do
        puts opts
        exit(0)
      end
    end.parse!

    abort('Error: expected exactly one image, or --all.') unless all ? ARGV.empty? : ARGV.length == 1

    { image: ARGV.first }
  rescue OptionParser::ParseError => e
    abort("Error: #{e.message}.")
  end
end

class Settings
  DIR = File.join(Dir.home, '.config', 'sndbx').freeze
  PATH = File.join(DIR, 'settings.yml').freeze
  HOME_ROOT = '/home'.freeze
  DEFAULT_TAG_PREFIX = 'sndbx'.freeze
  TAG_PREFIX_FORMAT = %r{\A[a-z0-9]+(?:[._/-][a-z0-9]+)*\z}.freeze

  EXAMPLE = <<~YAML.freeze
    # tag_prefix: sndbx # optional, images are tagged <tag_prefix>:<name>
    images:
      - name: claude
        user: ubuntu
        # tag: my-claude:latest # optional, defaults to <tag_prefix>:<name>
        # config_dir: ~/.claude_docker # optional, defaults to ~/.config/sndbx/<name>
        # config_target: .claude # optional, relative to the user's home, defaults to .<name>
        # ports: ['3000'] # optional, always published; quote them, YAML reads 8080:22 as a number
        # docker_args: ['--memory=8g'] # optional, extra docker run arguments
    # images_dir: ~/src/sndbx/images # optional, where build finds images, defaults to images/ next to bin/
  YAML

  def image(name)
    image = images.find { |entry| entry['name'] == name }
    abort("Error: unknown image '#{name}', expected one of: #{image_names.join(', ')}.") unless image

    abort("Error: image '#{name}' has no user in #{PATH}.") unless image['user']

    ports = Array(image['ports'])
    ports.each do |port|
      next if port.is_a?(String)

      abort("Error: image '#{name}' has an unquoted port in #{PATH}, YAML read it as #{port.inspect}; quote it, e.g. \"3000\".")
    end

    docker_args = Array(image['docker_args'])
    abort("Error: image '#{name}' has docker_args that aren't strings in #{PATH}.") unless docker_args.all?(String)

    {
      name: name,
      tag: image['tag'] || "#{tag_prefix}:#{name}",
      user: image['user'],
      config_dir: File.expand_path(image['config_dir'] || File.join(DIR, name)),
      config_target: File.join(HOME_ROOT, image['user'], image['config_target'] || ".#{name}"),
      ports: ports,
      docker_args: docker_args
    }
  end

  def image_names
    images.map { |entry| entry['name'] }
  end

  def tag_prefix
    return DEFAULT_TAG_PREFIX unless File.exist?(PATH)

    settings['tag_prefix'] || DEFAULT_TAG_PREFIX
  end

  # __dir__ resolves symlinks, so the default finds the repo when bin/sndbx is linked into PATH, but not when it's copied.
  def images_dir
    dir = settings['images_dir'] if File.exist?(PATH)
    return File.expand_path(dir, DIR) if dir

    File.expand_path('../images', __dir__)
  end

  private

  def images
    settings['images'] || []
  end

  def settings
    @settings ||= validate(load)
  end

  def validate(settings)
    abort("Error: invalid #{PATH}: expected a mapping with an images list.") unless settings.is_a?(Hash)

    prefix = settings['tag_prefix']
    unless prefix.nil? || (prefix.is_a?(String) && prefix.match?(TAG_PREFIX_FORMAT))
      abort("Error: invalid #{PATH}: tag_prefix must be a lowercase image name, e.g. sndbx.")
    end

    images_dir = settings['images_dir']
    abort("Error: invalid #{PATH}: images_dir must be a path.") unless images_dir.nil? || images_dir.is_a?(String)

    images = settings['images'] || []
    abort("Error: invalid #{PATH}: images must be a list.") unless images.is_a?(Array)

    images.each.with_index(1) do |entry, number|
      next if entry.is_a?(Hash) && entry['name'].is_a?(String)

      abort("Error: invalid #{PATH}: image #{number} must be a mapping with a name.")
    end

    settings
  end

  def load
    create_example unless File.exist?(PATH)

    YAML.safe_load_file(PATH) || {}
  rescue Psych::Exception => e
    abort("Error: invalid #{PATH}: #{e.message}.")
  end

  def create_example
    FileUtils.mkdir_p(DIR)
    File.write(PATH, EXAMPLE)

    abort("Created an example config at #{PATH}, edit it and run again.")
  end
end

# Builds images from images_dir/<name>/, always without the docker cache.
# Images are tagged <tag_prefix>:<name>.
# An image built FROM ${TAG_PREFIX}:base gets the base image built first, but only if it doesn't exist yet.
class Builder
  DOCKER = 'docker'.freeze
  BASE_NAME = 'base'.freeze
  BASE_FROM_FORMAT = /^FROM\s+\$\{TAG_PREFIX\}:#{BASE_NAME}(?:\s|$)/.freeze
  IMAGES_DIR_SETTING = 'images_dir'.freeze

  def initialize(settings)
    @tag_prefix = settings.tag_prefix
    @images_dir = settings.images_dir
  end

  # Every directory in images_dir with a Dockerfile, base included.
  def image_names
    check_images_dir
    Dir.glob('*/Dockerfile', base: @images_dir).map { |path| File.dirname(path) }.sort
  end

  # Builds every image when image is nil.
  def call(image:)
    names = image_names
    abort("Error: unknown image '#{image}', expected one of: #{names.join(', ')}.") unless image.nil? || names.include?(image)

    check_docker

    if image
      build_with_base(image)
    else
      # Base goes first, so every other image is built on the fresh one.
      [BASE_NAME, *(names - [BASE_NAME])].each { |name| build_with_base(name) }
    end
  end

  private

  def build_with_base(name)
    if name != BASE_NAME && needs_base?(name) && !base_exists?
      puts "==> #{tag_for(BASE_NAME)} doesn't exist yet"
      build(BASE_NAME)
    end

    build(name)
  end

  def build(name)
    tag = tag_for(name)

    # Only images FROM ${TAG_PREFIX}:base declare the arg, docker warns about unused ones.
    args = needs_base?(name) ? ['--build-arg', "TAG_PREFIX=#{@tag_prefix}"] : []

    puts "==> Building #{tag} from #{image_dir(name)}"
    abort("Error: failed to build #{tag}.") unless system(DOCKER, 'build', '--no-cache', *args, '-t', tag, image_dir(name))
  end

  def needs_base?(name)
    File.read(File.join(image_dir(name), 'Dockerfile')).match?(BASE_FROM_FORMAT)
  end

  def base_exists?
    quiet_system(DOCKER, 'image', 'inspect', tag_for(BASE_NAME))
  end

  def tag_for(name)
    "#{@tag_prefix}:#{name}"
  end

  def image_dir(name)
    File.join(@images_dir, name)
  end

  def check_images_dir
    return if File.directory?(@images_dir)

    abort("Error: images directory #{@images_dir} does not exist, set #{IMAGES_DIR_SETTING} in #{Settings::PATH}.")
  end

  def check_docker
    abort('Error: docker is not installed.') unless quiet_system(DOCKER, '--version')
    abort('Error: docker is not running.') unless quiet_system(DOCKER, 'info')
  end

  def quiet_system(*command)
    system(*command, out: File::NULL, err: File::NULL)
  end
end

class Sandbox
  DOCKER = 'docker'.freeze
  RUN_OPTIONS = ['run', '--rm', '-it'].freeze
  MOUNT_ROOT = '/workspace'.freeze
  PORT_FORMAT = %r{\A(?:[\d.]+:)?\d+(?::\d+)?(?:/(?:tcp|udp))?\z}.freeze
  BARE_PORT_FORMAT = %r{\A(\d+)(/(?:tcp|udp))?\z}.freeze
  MAX_PORT = 65_535
  FORBIDDEN_DIRS = [Dir.home, '/'].map { |dir| File.realpath(dir) }.freeze

  def initialize(image:, volumes:, ports:, workdir:)
    @image = image
    @mounts = mounts(volumes.empty? ? [Dir.pwd] : volumes)
    @ports = (image[:ports] + ports).map { |port| normalize_port(port) }.uniq
    @workdir = workdir || @mounts.keys.last
  end

  def call
    check_docker
    check_workdir
    FileUtils.mkdir_p(@image[:config_dir])

    exec(DOCKER, *RUN_OPTIONS, "--workdir=#{mount_target(@workdir)}", *volume_args, *port_args, *@image[:docker_args], @image[:tag])
  end

  private

  def mounts(volumes)
    volumes.each_with_object({}) do |volume, mounts|
      path = File.expand_path(volume)
      name = File.basename(path)

      abort("Error: #{path} is not a directory.") unless File.directory?(path)
      abort("Error: refusing to mount #{path}.") if FORBIDDEN_DIRS.include?(File.realpath(path))
      abort("Error: more than one volume is named '#{name}'.") if mounts.key?(name)

      mounts[name] = path
    end
  end

  def volume_args
    @mounts
      .map { |name, path| "#{path}:#{mount_target(name)}" }
      .push("#{@image[:config_dir]}:#{@image[:config_target]}")
      .flat_map { |volume| ['-v', volume] }
  end

  def normalize_port(port)
    abort("Error: invalid port '#{port}', expected PORT or HOST:CONTAINER.") unless port.match?(PORT_FORMAT)
    abort("Error: invalid port '#{port}', ports go up to #{MAX_PORT}.") if port_numbers(port).any? { |number| number > MAX_PORT }

    port.sub(BARE_PORT_FORMAT, '\\1:\\1\\2')
  end

  def port_numbers(port)
    port.sub(%r{/.*\z}, '').split(':').last(2).map(&:to_i)
  end

  def port_args
    @ports.flat_map { |port| ['-p', port] }
  end

  def mount_target(name)
    File.join(MOUNT_ROOT, name)
  end

  def check_docker
    abort('Error: docker is not installed.') unless quiet_system(DOCKER, '--version')
    abort('Error: docker is not running.') unless quiet_system(DOCKER, 'info')
    abort("Error: docker image '#{@image[:tag]}' does not exist.") unless quiet_system(DOCKER, 'image', 'inspect', @image[:tag])
  end

  def check_workdir
    return if @mounts.key?(@workdir)

    abort("Error: workdir '#{@workdir}' is not a volume, expected one of: #{@mounts.keys.join(', ')}.")
  end

  def quiet_system(*command)
    system(*command, out: File::NULL, err: File::NULL)
  end
end

ARGV << '-h' if ARGV.empty?

case SndbxCliParser.new.call
when 'run'
  options = RunCliParser.new.call
  Sandbox.new(**options.merge(image: Settings.new.image(options[:image]))).call
when 'build'
  Builder.new(Settings.new).call(**BuildCliParser.new.call)
end
