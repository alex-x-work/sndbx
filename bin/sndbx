#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true

require 'English'
require 'fileutils'
require 'optparse'
require 'yaml'

module Sndbx
  VERSION = '0.17.0'

  class Error < StandardError; end

  module Command
    def call
      run(**parse)
    end

    private

    def help_option(opts)
      opts.on('-h', '--help', 'Print help') do
        puts opts
        exit(0)
      end
    end
  end

  module Docker
    DOCKER = 'docker'
    IMAGE_LABEL = 'sndbx.image'

    private

    def check_docker
      case quiet_system(DOCKER, 'info')
      when nil then raise Error, 'docker is not installed'
      when false then raise Error, 'docker is not running'
      end
    end

    def image_exists?(tag)
      quiet_system(DOCKER, 'image', 'inspect', tag)
    end

    def running_containers(image)
      containers(image)
    end

    def stopped_containers(image)
      containers(image, '--all', '--filter', 'status=exited')
    end

    def containers(image, *ps_args)
      names = IO.popen([DOCKER, 'ps', *ps_args, '--filter', "label=#{IMAGE_LABEL}=#{image}", '--format', '{{.Names}}'],
                       err: File::NULL, &:readlines)
      raise Error, 'failed to list containers' unless $CHILD_STATUS.success?

      names.map(&:chomp)
    end

    def check_container(container, containers, description)
      raise Error, "no #{description}" if containers.empty?
      return if containers.include?(container)

      raise Error, "container '#{container}' is not a #{description}, expected one of: #{containers.join(', ')}"
    end

    def quiet_system(*command)
      system(*command, out: File::NULL, err: File::NULL)
    end
  end

  class RunCommand
    include Command

    private

    def parse
      volumes = []
      ports = []
      workdir = nil
      keep = false
      separator = ARGV.index('--')
      docker_args = separator ? ARGV.slice!(separator..).drop(1) : []

      OptionParser.new do |opts|
        opts.banner = 'Usage: sndbx run IMAGE [options] [-- DOCKER_ARGS]'
        opts.separator ''
        opts.separator "Runs a sandboxed image from #{Settings::PATH}."
        opts.separator "Mounts the current directory unless a volume is mounted in #{Sandbox::MOUNT_ROOT}."
        opts.separator "Passes DOCKER_ARGS to docker run after the image's docker_args."
        opts.separator ''

        opts.on('-v', '--volume=SRC[:DST[:OPTS]]',
                "Mount SRC at DST, #{Sandbox::MOUNT_ROOT}/<basename> by default,",
                "with docker's OPTS, e.g. ro, repeatable") do |volume|
          volumes.push(volume)
        end

        opts.on('-w', '--workdir=NAME', "Start in #{Sandbox::MOUNT_ROOT}/<NAME>, or NAME if it's absolute,",
                "the last directory volume in #{Sandbox::MOUNT_ROOT} by default") do |name|
          workdir = name
        end

        opts.on('-p', '--publish=PORT', 'Publish a port as HOST:CONTAINER, PORT means PORT:PORT, repeatable') do |port|
          ports.push(port)
        end

        opts.on('-k', '--keep', "Keep the container after it exits, docker run's --rm otherwise removes it") do
          keep = true
        end

        opts.on('-l', '--list', 'Print image names') do
          puts Settings.new.image_names if File.exist?(Settings::PATH)
          exit(0)
        end

        help_option(opts)
      end.parse!

      raise Error, 'expected exactly one image' unless ARGV.length == 1

      { image: ARGV.first, volumes: volumes, ports: ports, workdir: workdir, keep: keep,
        docker_args: docker_args }
    end

    def run(image:, **options)
      Sandbox.new(image: Settings.new.image(image), **options).call
    end
  end

  class BuildCommand
    include Command

    private

    def parse
      all = false

      OptionParser.new do |opts|
        opts.banner = 'Usage: sndbx build IMAGE | --all'
        opts.separator ''
        opts.separator "Builds an image from #{Builder::IMAGES_DIR_SETTING}/IMAGE, always without the docker cache."
        opts.separator "Builds #{Builder::BASE_NAME} first if the image needs it and it doesn't exist yet."
        opts.separator ''

        opts.on('-a', '--all', "Build #{Builder::BASE_NAME}, then every other image") do
          all = true
        end

        opts.on('-l', '--list', 'Print image names') do
          puts Builder.new(Settings.new).image_names
          exit(0)
        end

        help_option(opts)
      end.parse!

      raise Error, 'expected exactly one image, or --all' unless all ? ARGV.empty? : ARGV.length == 1

      { image: ARGV.first }
    end

    def run(image:)
      Builder.new(Settings.new).call(image: image)
    end
  end

  class ExecCommand
    include Command
    include Docker

    private

    def parse
      user = nil
      list = false
      positionals = []

      parser = OptionParser.new do |opts|
        opts.banner = 'Usage: sndbx exec IMAGE CONTAINER COMMAND [ARGS] | IMAGE --list'
        opts.separator ''
        opts.separator 'Runs COMMAND in a running sandbox of IMAGE, like docker exec -i,'
        opts.separator 'with -t when stdin is a terminal.'
        opts.separator 'Options go before COMMAND, everything from COMMAND on goes to it.'
        opts.separator ''

        opts.on('-u', '--user=USER', "Run COMMAND as USER, the container's user by default") do |name|
          raise Error, 'expected a user' if name.empty?

          user = name
        end

        opts.on('-l', '--list', "Print IMAGE's running containers") do
          list = true
        end

        help_option(opts)
      end

      # Stop at COMMAND, the third positional, so its own options reach it
      catch(:command) do
        parser.order!(ARGV) do |arg|
          if positionals.length == 2
            ARGV.unshift(arg)
            throw(:command)
          end

          positionals.push(arg)
        end
      end

      # -- ends the options, the words after it start with the missing positionals
      positionals.push(ARGV.shift) while positionals.length < 2 && ARGV.any?

      if list
        raise Error, 'expected exactly one image' unless positionals.length == 1 && ARGV.empty?

        return { image: positionals.first, list: true }
      end

      raise Error, 'expected an image, a container and a command' unless positionals.length == 2 && ARGV.any?

      { image: positionals[0], container: positionals[1], command: ARGV.dup, user: user }
    end

    def run(image:, list: false, **options)
      if list
        check_docker
        running_containers(image).each { |name| puts name }
      else
        Settings.new.image(image)
        exec_in(image, **options)
      end
    end

    def exec_in(image, container:, command:, user:)
      check_docker
      check_container(container, running_containers(image), "running #{image} sandbox")

      # Without a terminal on stdin docker refuses -t, which breaks pipes and scripts
      tty_args = $stdin.tty? ? ['-it'] : ['-i']
      user_args = user ? ["--user=#{user}"] : []
      exec(DOCKER, 'exec', *tty_args, *user_args, container, *command)
    end
  end

  class ResumeCommand
    include Command
    include Docker

    private

    def parse
      list = false

      OptionParser.new do |opts|
        opts.banner = 'Usage: sndbx resume IMAGE CONTAINER | IMAGE --list'
        opts.separator ''
        opts.separator 'Restarts a stopped sandbox of IMAGE, kept by run --keep, and attaches to it,'
        opts.separator 'like docker start -ai.'
        opts.separator ''

        opts.on('-l', '--list', "Print IMAGE's stopped containers") do
          list = true
        end

        help_option(opts)
      end.parse!

      if list
        raise Error, 'expected exactly one image' unless ARGV.length == 1

        return { image: ARGV.first, list: true }
      end

      raise Error, 'expected an image and a container' unless ARGV.length == 2

      { image: ARGV[0], container: ARGV[1] }
    end

    def run(image:, list: false, container: nil)
      if list
        check_docker
        stopped_containers(image).each { |name| puts name }
      else
        Settings.new.image(image)
        check_docker
        check_container(container, stopped_containers(image), "stopped #{image} sandbox")
        exec(DOCKER, 'start', '-ai', container)
      end
    end
  end

  class CLI
    include Command

    COMMANDS = {
      'run' => RunCommand,
      'build' => BuildCommand,
      'exec' => ExecCommand,
      'resume' => ResumeCommand
    }.freeze

    private

    def parse
      ARGV << '-h' if ARGV.empty?

      parser = OptionParser.new do |opts|
        opts.banner = 'Usage: sndbx command [options]'
        opts.separator ''
        opts.separator 'Commands:'
        opts.separator '    run IMAGE                       Run a sandboxed image'
        opts.separator '    build IMAGE                     Build an image'
        opts.separator '    exec IMAGE CONTAINER COMMAND    Run a command in a running sandbox'
        opts.separator '    resume IMAGE CONTAINER          Restart a stopped sandbox'
        opts.separator ''
        opts.separator "Run 'sndbx command --help' for a command's options."
        opts.separator ''

        opts.on('-V', '--version', 'Print version') do
          puts "sndbx #{VERSION}"
          exit(0)
        end

        help_option(opts)
      end

      parser.order!
      name = ARGV.shift

      abort(parser.help) unless name
      command = COMMANDS.fetch(name) do
        raise Error, "unknown command '#{name}', expected one of: #{COMMANDS.keys.join(', ')}"
      end

      { command: command }
    end

    def run(command:)
      command.new.call
    end
  end

  class Settings
    DIR = File.join(Dir.home, '.config', 'sndbx').freeze
    PATH = File.join(DIR, 'settings.yml').freeze
    HOME_ROOT = '/home'
    DEFAULT_TAG_PREFIX = 'sndbx'
    TAG_PREFIX_FORMAT = %r{\A[a-z0-9]+(?:[._/-][a-z0-9]+)*\z}.freeze

    EXAMPLE = <<~YAML
      # tag_prefix: sndbx # optional, images are tagged <tag_prefix>:<name>
      images:
        - name: claude
          user: ubuntu
          # tag: my-claude:latest # optional, defaults to <tag_prefix>:<name>
          # config_dir: ~/.claude_docker # optional, relative paths resolve against ~/.config/sndbx, defaults to ~/.config/sndbx/<name>
          # config_target: .claude # optional, relative to the user's home, defaults to .<name>
          # ports: ['3000'] # optional, always published; quote them, YAML reads 8080:22 as a number
          # docker_args: ['--memory=8g'] # optional, extra docker run arguments
      # images_dir: ~/src/sndbx/images # optional, where build finds images, defaults to images/ next to bin/
    YAML

    def image(name)
      image = images.find { |entry| entry['name'] == name }
      raise Error, "unknown image '#{name}', expected one of: #{image_names.join(', ')}" unless image

      raise Error, "image '#{name}' has no user in #{PATH}" unless image['user']

      ports = Array(image['ports'])
      ports.each do |port|
        next if port.is_a?(String)

        raise Error, "image '#{name}' has an unquoted port in #{PATH}, YAML read it as #{port.inspect}; " \
                     'quote it, e.g. "3000"'
      end

      docker_args = Array(image['docker_args'])
      raise Error, "image '#{name}' has docker_args that aren't strings in #{PATH}" unless docker_args.all?(String)

      config_dir = image['config_dir']
      valid_config_dir = config_dir.nil? || (config_dir.is_a?(String) && !config_dir.empty?)
      raise Error, "image '#{name}' has a config_dir that isn't a path in #{PATH}" unless valid_config_dir

      {
        name: name,
        tag: image['tag'] || "#{tag_prefix}:#{name}",
        user: image['user'],
        config_dir: File.expand_path(config_dir || name, DIR),
        config_target: File.join(HOME_ROOT, image['user'], image['config_target'] || ".#{name}"),
        ports: ports,
        docker_args: docker_args
      }
    end

    def image_names
      images.map { |entry| entry['name'] }
    end

    def tag_prefix
      optional_setting('tag_prefix') || DEFAULT_TAG_PREFIX
    end

    # __dir__ resolves symlinks, so the default finds the repo when bin/sndbx is linked into PATH,
    # but not when it's copied.
    def images_dir
      dir = optional_setting('images_dir')
      return File.expand_path(dir, DIR) if dir

      File.expand_path('../images', __dir__)
    end

    private

    def images
      settings['images'] || []
    end

    def optional_setting(key)
      settings[key] if File.exist?(PATH)
    end

    def settings
      @settings ||= validate(load)
    end

    def validate(settings)
      raise Error, "invalid #{PATH}: expected a mapping with an images list" unless settings.is_a?(Hash)

      prefix = settings['tag_prefix']
      unless prefix.nil? || (prefix.is_a?(String) && prefix.match?(TAG_PREFIX_FORMAT))
        raise Error, "invalid #{PATH}: tag_prefix must be a lowercase image name, e.g. sndbx"
      end

      images_dir = settings['images_dir']
      raise Error, "invalid #{PATH}: images_dir must be a path" unless images_dir.nil? || images_dir.is_a?(String)

      images = settings['images'] || []
      raise Error, "invalid #{PATH}: images must be a list" unless images.is_a?(Array)

      images.each.with_index(1) do |entry, number|
        next if entry.is_a?(Hash) && entry['name'].is_a?(String)

        raise Error, "invalid #{PATH}: image #{number} must be a mapping with a name"
      end

      settings
    end

    def load
      create_example unless File.exist?(PATH)

      YAML.safe_load_file(PATH) || {}
    rescue Psych::Exception => e
      raise Error, "invalid #{PATH}: #{e.message}"
    end

    def create_example
      FileUtils.mkdir_p(DIR)
      File.write(PATH, EXAMPLE)

      abort("Created an example config at #{PATH}, edit it and run again.")
    end
  end

  class Builder
    include Docker

    BASE_NAME = 'base'
    BASE_FROM_FORMAT = /^FROM\s+\$\{TAG_PREFIX\}:#{BASE_NAME}(?:\s|$)/.freeze
    IMAGES_DIR_SETTING = 'images_dir'

    def initialize(settings)
      @tag_prefix = settings.tag_prefix
      @images_dir = settings.images_dir
    end

    def image_names
      check_images_dir
      Dir.glob('*/Dockerfile', base: @images_dir).map { |path| File.dirname(path) }.sort
    end

    def call(image:)
      names = image_names
      known_image = image.nil? || names.include?(image)
      raise Error, "unknown image '#{image}', expected one of: #{names.join(', ')}" unless known_image

      check_docker

      if image
        build_with_base(image)
      else
        [BASE_NAME, *(names - [BASE_NAME])].each { |name| build_with_base(name) }
      end
    end

    private

    def build_with_base(name)
      if name != BASE_NAME && needs_base?(name) && !base_exists?
        puts "==> #{tag_for(BASE_NAME)} doesn't exist yet"
        build(BASE_NAME)
      end

      build(name)
    end

    def build(name)
      tag = tag_for(name)

      # Only images FROM ${TAG_PREFIX}:base declare the arg, docker warns about unused ones.
      args = needs_base?(name) ? ['--build-arg', "TAG_PREFIX=#{@tag_prefix}"] : []

      puts "==> Building #{tag} from #{image_dir(name)}"
      built = system(DOCKER, 'build', '--no-cache', *args, '-t', tag, image_dir(name))
      raise Error, "failed to build #{tag}" unless built
    end

    def needs_base?(name)
      File.read(File.join(image_dir(name), 'Dockerfile')).match?(BASE_FROM_FORMAT)
    end

    def base_exists?
      image_exists?(tag_for(BASE_NAME))
    end

    def tag_for(name)
      "#{@tag_prefix}:#{name}"
    end

    def image_dir(name)
      File.join(@images_dir, name)
    end

    def check_images_dir
      return if File.directory?(@images_dir)

      raise Error, "images directory #{@images_dir} does not exist, set #{IMAGES_DIR_SETTING} in #{Settings::PATH}"
    end
  end

  class Sandbox
    include Docker

    MOUNT_ROOT = '/workspace'
    PORT_FORMAT = %r{\A(?:[\d.]+:)?\d+(?::\d+)?(?:/(?:tcp|udp))?\z}.freeze
    BARE_PORT_FORMAT = %r{\A(\d+)(/(?:tcp|udp))?\z}.freeze
    MAX_PORT = 65_535
    VOLUME_FORMAT = /\A([^:]+)(?::([^:]+))?(?::([^:]+))?\z/.freeze
    FORBIDDEN_DIRS = [Dir.home, '/'].freeze

    def initialize(image:, volumes:, ports:, workdir:, keep:, docker_args:)
      @image = image
      @keep = keep
      @docker_args = image[:docker_args] + docker_args
      @volumes = volumes(volumes)
      @ports = (image[:ports] + ports).map { |port| normalize_port(port) }.uniq
      @workdir = workdir ? workdir_target(workdir) : default_workdir
    end

    def call
      check_docker
      check_image
      check_workdir
      FileUtils.mkdir_p(@image[:config_dir])

      exec(DOCKER, 'run', *('--rm' unless @keep), '-it', "--label=#{IMAGE_LABEL}=#{@image[:name]}",
           "--workdir=#{@workdir}", *volume_args, *port_args, *@docker_args, @image[:tag])
    end

    private

    def volumes(specs)
      volumes = specs.map { |spec| parse_volume(spec) }
      volumes.unshift(parse_volume(Dir.pwd)) unless volumes.any? { |volume| workspace?(volume[:target]) }

      volumes.map { |volume| volume[:target] }.tally.each do |target, count|
        raise Error, "more than one volume is mounted at #{target}" if count > 1
      end

      volumes
    end

    # Docker's -v syntax, SRC[:DST[:OPTS]], except that SRC is always a host path
    # and DST defaults to MOUNT_ROOT/<basename>.
    def parse_volume(spec)
      match = spec.match(VOLUME_FORMAT)
      raise Error, "invalid volume '#{spec}', expected SRC[:DST[:OPTS]]" unless match

      source = File.expand_path(match[1])
      raise Error, "#{source} does not exist" unless File.exist?(source)
      raise Error, "refusing to mount #{source}" if FORBIDDEN_DIRS.any? { |dir| File.identical?(dir, source) }

      if match[2]
        raise Error, "invalid volume '#{spec}', DST must be an absolute path" unless match[2].start_with?('/')

        target = File.expand_path(match[2])
      else
        raise Error, "#{source} is not a directory" unless File.directory?(source)

        target = mount_target(File.basename(source))
      end

      { source: source, target: target, options: match[3] }
    end

    def volume_args
      @volumes
        .map { |volume| volume.values_at(:source, :target, :options).compact.join(':') }
        .push("#{@image[:config_dir]}:#{@image[:config_target]}")
        .flat_map { |volume| ['-v', volume] }
    end

    def directory_targets
      @volumes.select { |volume| File.directory?(volume[:source]) }.map { |volume| volume[:target] }
    end

    def default_workdir
      directory_targets.select { |target| workspace?(target) }.last || directory_targets.last
    end

    def workdir_target(name)
      name.start_with?('/') ? File.expand_path(name) : mount_target(name)
    end

    def workdir_name(target)
      target.delete_prefix("#{MOUNT_ROOT}/")
    end

    def workspace?(target)
      target == MOUNT_ROOT || target.start_with?("#{MOUNT_ROOT}/")
    end

    def normalize_port(port)
      raise Error, "invalid port '#{port}', expected PORT or HOST:CONTAINER" unless port.match?(PORT_FORMAT)

      too_high = port_numbers(port).any? { |number| number > MAX_PORT }
      raise Error, "invalid port '#{port}', ports go up to #{MAX_PORT}" if too_high

      port.sub(BARE_PORT_FORMAT, '\\1:\\1\\2')
    end

    def port_numbers(port)
      port.sub(%r{/.*\z}, '').split(':').last(2).map(&:to_i)
    end

    def port_args
      @ports.flat_map { |port| ['-p', port] }
    end

    def mount_target(name)
      File.join(MOUNT_ROOT, name)
    end

    def check_image
      raise Error, "docker image '#{@image[:tag]}' does not exist" unless image_exists?(@image[:tag])
    end

    def check_workdir
      names = directory_targets.map { |target| workdir_name(target) }
      raise Error, 'no directory volume to start in' if names.empty?
      return if directory_targets.include?(@workdir)

      raise Error, "workdir '#{workdir_name(@workdir)}' is not a directory volume, expected one of: #{names.join(', ')}"
    end
  end
end

begin
  Sndbx::CLI.new.call
rescue Sndbx::Error, OptionParser::ParseError => e
  abort("Error: #{e.message}.")
end
