#!/bin/bash

_sndbx() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="${COMP_WORDS[COMP_CWORD-1]}"
  local options='-v --volume -w --workdir -p --publish -l --list --tag-prefix -V --version -h --help'
  local has_image=0 i

  # Bash splits --volume=DIR into "--volume" "=" "DIR"
  if [[ "${cur}" == "=" ]]; then
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cur=""
  elif [[ "${prev}" == "=" ]]; then
    prev="${COMP_WORDS[COMP_CWORD-2]}"
  fi

  # Look for an image already given before the current word, skipping option values
  for (( i = 1; i < COMP_CWORD; i++ )); do
    case "${COMP_WORDS[i]}" in
      -v|--volume|-w|--workdir|-p|--publish)
        (( i++ ))
        [[ "${COMP_WORDS[i]}" == "=" ]] && (( i++ ))
        ;;
      -*) ;;
      *) has_image=1 ;;
    esac
  done

  case "${prev}" in
    -v|--volume)
      compopt -o filenames
      mapfile -t COMPREPLY < <(compgen -d -- "${cur}")
      ;;
    -w|--workdir|-p|--publish)
      COMPREPLY=()
      ;;
    *)
      if [[ "${cur}" == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "${options}" -- "${cur}")
      elif (( ! has_image )); then
        mapfile -t COMPREPLY < <(compgen -W "$(sndbx --list 2>/dev/null)" -- "${cur}")
      else
        COMPREPLY=()
      fi
      ;;
  esac

  return 0
}

complete -F _sndbx sndbx
