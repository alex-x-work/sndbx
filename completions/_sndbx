#!/bin/bash

_sndbx() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="${COMP_WORDS[COMP_CWORD-1]}"
  local command="${COMP_WORDS[1]}"
  local has_image=0 has_workspace=0 i option value dir target
  local -a workdirs=()

  if (( COMP_CWORD == 1 )); then
    if [[ "${cur}" == -* ]]; then
      mapfile -t COMPREPLY < <(compgen -W '-V --version -h --help' -- "${cur}")
    else
      mapfile -t COMPREPLY < <(compgen -W 'run build' -- "${cur}")
    fi
    return 0
  fi

  # Bash splits --volume=SRC:DST into "--volume" "=" "SRC" ":" "DST", nothing completes DST or the rest
  if [[ "${cur}" == ":" || "${prev}" == ":" ]]; then
    COMPREPLY=()
    return 0
  elif [[ "${cur}" == "=" ]]; then
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cur=""
  elif [[ "${prev}" == "=" ]]; then
    prev="${COMP_WORDS[COMP_CWORD-2]}"
  fi

  # Look for an image and volumes given after the command and before the current word, skipping option values
  for (( i = 2; i < COMP_CWORD; i++ )); do
    case "${COMP_WORDS[i]}" in
      -v|--volume|-w|--workdir|-p|--publish)
        option="${COMP_WORDS[i]}"
        (( i++ ))
        [[ "${COMP_WORDS[i]}" == "=" ]] && (( i++ ))
        value="${COMP_WORDS[i]}"
        # Rejoin SRC:DST:OPTS and HOST:CONTAINER, which bash splits at each colon unless they're quoted
        while (( i + 2 < COMP_CWORD )) && [[ "${COMP_WORDS[i+1]}" == ":" ]]; do
          value+=":${COMP_WORDS[i+2]}"
          (( i += 2 ))
        done
        [[ "${option}" == -v || "${option}" == --volume ]] || continue

        value="${value//[\"\']/}"
        dir="${value%%:*}"
        dir="${dir/#\~/${HOME}}"
        dir="$(cd -- "${dir}" 2>/dev/null && pwd)" || continue
        target=""
        [[ "${value}" == *:* ]] && target="${value#*:}" && target="${target%%:*}"

        # Workdir names a volume in /workspace by its path there, any other by its absolute path
        if [[ -z "${target}" ]]; then
          workdirs+=("${dir##*/}")
          has_workspace=1
        elif [[ "${target}" == /workspace/* ]]; then
          workdirs+=("${target#/workspace/}")
          has_workspace=1
        else
          [[ "${target}" == /workspace ]] && has_workspace=1
          workdirs+=("${target}")
        fi
        ;;
      -a|--all) has_image=1 ;;
      -*) ;;
      *) has_image=1 ;;
    esac
  done

  case "${command}" in
    run)
      case "${prev}" in
        -v|--volume)
          compopt -o filenames
          mapfile -t COMPREPLY < <(compgen -d -- "${cur}")
          ;;
        -w|--workdir)
          # The current directory is mounted unless a volume is in /workspace
          (( has_workspace )) || workdirs+=("${PWD##*/}")
          mapfile -t COMPREPLY < <(compgen -W "${workdirs[*]}" -- "${cur}")
          ;;
        -p|--publish)
          COMPREPLY=()
          ;;
        *)
          if [[ "${cur}" == -* ]]; then
            mapfile -t COMPREPLY < <(compgen -W '-v --volume -w --workdir -p --publish -l --list -h --help' -- "${cur}")
          elif (( ! has_image )); then
            mapfile -t COMPREPLY < <(compgen -W "$(sndbx run --list 2>/dev/null)" -- "${cur}")
          else
            COMPREPLY=()
          fi
          ;;
      esac
      ;;
    build)
      if [[ "${cur}" == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W '-a --all -l --list -h --help' -- "${cur}")
      elif (( ! has_image )); then
        mapfile -t COMPREPLY < <(compgen -W "$(sndbx build --list 2>/dev/null)" -- "${cur}")
      else
        COMPREPLY=()
      fi
      ;;
    *)
      COMPREPLY=()
      ;;
  esac

  return 0
}

complete -F _sndbx sndbx
